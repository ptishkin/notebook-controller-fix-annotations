From 7614a4bc74cfa6b88e63a91f50272227e0ff9b92 Mon Sep 17 00:00:00 2001
From: ptishkin <104498557+ptishkin@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:13:13 +0300
Subject: [PATCH] fix: merge instead of overwrite labels/annotations in
 Copy*Fields

Upstream CopyServiceFields/CopyStatefulSetFields/CopyDeploymentSetFields
assigned to.Annotations = from.Annotations directly. Since generateService()
creates the desired Service without any annotations, every reconcile wiped
annotations added to the live Service by other controllers (e.g. OVN CNI)
and pushed the wipe via r.Update(), creating an endless patch/update fight
visible in the API-server audit log.

New semantics: mergeStringMap() adds/updates keys coming from the desired
state but never deletes keys that exist only on the live object. For a
vanilla Kubeflow deployment behavior is unchanged (the controller does not
generate any annotations/labels for the Service; STS labels/annotations are
a superset of what it sets).

Tests: notebook-controller/tests/reconcilehelper_merge_test.go
- foreign annotations/labels survive CopyServiceFields/CopyStatefulSetFields
- owned keys are still added/updated
- replicas/spec copying unchanged
---
 common/reconcilehelper/util.go                |  80 +++++++----
 .../tests/reconcilehelper_merge_test.go       | 135 ++++++++++++++++++
 2 files changed, 184 insertions(+), 31 deletions(-)
 create mode 100644 notebook-controller/tests/reconcilehelper_merge_test.go

diff --git a/common/reconcilehelper/util.go b/common/reconcilehelper/util.go
index ded19b0..34f23dd 100644
--- a/common/reconcilehelper/util.go
+++ b/common/reconcilehelper/util.go
@@ -102,23 +102,44 @@ func VirtualService(ctx context.Context, r client.Client, virtualServiceName, na
 
 // Reference: https://github.com/pwittrock/kubebuilder-workshop/blob/master/pkg/util/util.go
 
+// mergeStringMap merges keys/values from src into dst without deleting
+// keys that exist only in dst (set by other controllers, e.g. CNI sidecars).
+// Returns true if dst was changed.
+func mergeStringMap(dst *map[string]string, src map[string]string) bool {
+	changed := false
+	if len(src) == 0 {
+		return false
+	}
+	if *dst == nil {
+		*dst = map[string]string{}
+	}
+	for k, v := range src {
+		if (*dst)[k] != v {
+			(*dst)[k] = v
+			changed = true
+		}
+	}
+	return changed
+}
+
 // CopyStatefulSetFields copies the owned fields from one StatefulSet to another
 // Returns true if the fields copied from don't match to.
+//
+// NOTE (annotation-merge fix): labels and annotations are MERGED instead of
+// replaced. The upstream implementation assigned from.Labels/from.Annotations
+// directly, which wiped any labels/annotations added to the live object by
+// other controllers (e.g. CNI, istio, monitoring) on every reconcile, causing
+// update-fight loops. With the merge semantics below the controller still
+// adds/updates its own keys but never deletes foreign ones.
 func CopyStatefulSetFields(from, to *appsv1.StatefulSet) bool {
 	requireUpdate := false
-	for k, v := range to.Labels {
-		if from.Labels[k] != v {
-			requireUpdate = true
-		}
+	if mergeStringMap(&to.Labels, from.Labels) {
+		requireUpdate = true
 	}
-	to.Labels = from.Labels
 
-	for k, v := range to.Annotations {
-		if from.Annotations[k] != v {
-			requireUpdate = true
-		}
+	if mergeStringMap(&to.Annotations, from.Annotations) {
+		requireUpdate = true
 	}
-	to.Annotations = from.Annotations
 
 	if *from.Spec.Replicas != *to.Spec.Replicas {
 		*to.Spec.Replicas = *from.Spec.Replicas
@@ -133,21 +154,17 @@ func CopyStatefulSetFields(from, to *appsv1.StatefulSet) bool {
 	return requireUpdate
 }
 
+// CopyDeploymentSetFields follows the same merge semantics as
+// CopyStatefulSetFields (see the annotation-merge fix note there).
 func CopyDeploymentSetFields(from, to *appsv1.Deployment) bool {
 	requireUpdate := false
-	for k, v := range to.Labels {
-		if from.Labels[k] != v {
-			requireUpdate = true
-		}
+	if mergeStringMap(&to.Labels, from.Labels) {
+		requireUpdate = true
 	}
-	to.Labels = from.Labels
 
-	for k, v := range to.Annotations {
-		if from.Annotations[k] != v {
-			requireUpdate = true
-		}
+	if mergeStringMap(&to.Annotations, from.Annotations) {
+		requireUpdate = true
 	}
-	to.Annotations = from.Annotations
 
 	if from.Spec.Replicas != to.Spec.Replicas {
 		to.Spec.Replicas = from.Spec.Replicas
@@ -162,22 +179,23 @@ func CopyDeploymentSetFields(from, to *appsv1.Deployment) bool {
 	return requireUpdate
 }
 
-// CopyServiceFields copies the owned fields from one Service to another
+// CopyServiceFields copies the owned fields from one Service to another.
+//
+// NOTE (annotation-merge fix): labels and annotations are MERGED instead of
+// replaced (same semantics as CopyStatefulSetFields). The upstream code did
+// to.Annotations = from.Annotations, and since generateService() creates the
+// desired Service without any annotations, every reconcile wiped annotations
+// added by other controllers (e.g. OVN CNI) and pushed them back via Update,
+// creating an endless patch/update fight visible in the audit log.
 func CopyServiceFields(from, to *corev1.Service) bool {
 	requireUpdate := false
-	for k, v := range to.Labels {
-		if from.Labels[k] != v {
-			requireUpdate = true
-		}
+	if mergeStringMap(&to.Labels, from.Labels) {
+		requireUpdate = true
 	}
-	to.Labels = from.Labels
 
-	for k, v := range to.Annotations {
-		if from.Annotations[k] != v {
-			requireUpdate = true
-		}
+	if mergeStringMap(&to.Annotations, from.Annotations) {
+		requireUpdate = true
 	}
-	to.Annotations = from.Annotations
 
 	// Don't copy the entire Spec, because we can't overwrite the clusterIp field
 
diff --git a/notebook-controller/tests/reconcilehelper_merge_test.go b/notebook-controller/tests/reconcilehelper_merge_test.go
new file mode 100644
index 0000000..e044d3d
--- /dev/null
+++ b/notebook-controller/tests/reconcilehelper_merge_test.go
@@ -0,0 +1,135 @@
+package tests
+
+import (
+	"testing"
+
+	reconcilehelper "github.com/kubeflow/kubeflow/components/common/reconcilehelper"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func int32Ptr(i int32) *int32 { return &i }
+
+// TestCopyServiceFields_PreservesForeignAnnotations verifies the
+// annotation-merge fix: annotations/labels present only on the live object
+// (set by other controllers, e.g. OVN CNI) must survive CopyServiceFields.
+// Upstream code did to.Annotations = from.Annotations, wiping them on every
+// reconcile and fighting with the controllers that set them.
+func TestCopyServiceFields_PreservesForeignAnnotations(t *testing.T) {
+	from := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "test",
+			Namespace: "test-ns",
+			// desired state has no annotations (as generateService produces)
+		},
+	}
+	to := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "test",
+			Namespace: "test-ns",
+			Annotations: map[string]string{
+				"ovn.example.com/some-annotation": "keep-me",
+			},
+			Labels: map[string]string{
+				"app": "test",
+			},
+		},
+	}
+
+	if reconcilehelper.CopyServiceFields(from, to) {
+		t.Fatalf("expected no update required when desired state is empty")
+	}
+	if got := to.Annotations["ovn.example.com/some-annotation"]; got != "keep-me" {
+		t.Fatalf("foreign annotation was wiped, got %q", got)
+	}
+	if got := to.Labels["app"]; got != "test" {
+		t.Fatalf("foreign label was wiped, got %q", got)
+	}
+}
+
+func TestCopyServiceFields_UpdatesOwnedKeys(t *testing.T) {
+	from := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Annotations: map[string]string{"owner": "notebook-controller"},
+			Labels:      map[string]string{"statefulset": "nb"},
+		},
+	}
+	to := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Annotations: map[string]string{
+				"owner":                           "old-value",
+				"ovn.example.com/some-annotation": "keep-me",
+			},
+		},
+	}
+
+	if !reconcilehelper.CopyServiceFields(from, to) {
+		t.Fatalf("expected update required when owned key differs")
+	}
+	if got := to.Annotations["owner"]; got != "notebook-controller" {
+		t.Fatalf("owned annotation not updated, got %q", got)
+	}
+	if got := to.Annotations["ovn.example.com/some-annotation"]; got != "keep-me" {
+		t.Fatalf("foreign annotation was wiped, got %q", got)
+	}
+	if got := to.Labels["statefulset"]; got != "nb" {
+		t.Fatalf("owned label not merged, got %q", got)
+	}
+}
+
+func TestCopyStatefulSetFields_PreservesForeignAnnotations(t *testing.T) {
+	from := &appsv1.StatefulSet{
+		ObjectMeta: metav1.ObjectMeta{Name: "test", Namespace: "test-ns"},
+		Spec: appsv1.StatefulSetSpec{
+			Replicas: int32Ptr(1),
+		},
+	}
+	to := &appsv1.StatefulSet{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "test",
+			Namespace: "test-ns",
+			Annotations: map[string]string{
+				"reloader.stakater.com/auto": "true",
+			},
+		},
+		Spec: appsv1.StatefulSetSpec{
+			Replicas: int32Ptr(1),
+		},
+	}
+
+	if reconcilehelper.CopyStatefulSetFields(from, to) {
+		t.Fatalf("expected no update required")
+	}
+	if got := to.Annotations["reloader.stakater.com/auto"]; got != "true" {
+		t.Fatalf("foreign annotation was wiped, got %q", got)
+	}
+}
+
+func TestCopyStatefulSetFields_UpdatesOwnedKeys(t *testing.T) {
+	from := &appsv1.StatefulSet{
+		ObjectMeta: metav1.ObjectMeta{
+			Annotations: map[string]string{"kubeflow-resource-stopped": "2026-01-01T00:00:00Z"},
+		},
+		Spec: appsv1.StatefulSetSpec{Replicas: int32Ptr(0)},
+	}
+	to := &appsv1.StatefulSet{
+		ObjectMeta: metav1.ObjectMeta{
+			Annotations: map[string]string{"foreign": "keep"},
+		},
+		Spec: appsv1.StatefulSetSpec{Replicas: int32Ptr(1)},
+	}
+
+	if !reconcilehelper.CopyStatefulSetFields(from, to) {
+		t.Fatalf("expected update required (replicas + annotation differ)")
+	}
+	if got := to.Annotations["kubeflow-resource-stopped"]; got != "2026-01-01T00:00:00Z" {
+		t.Fatalf("owned annotation not updated, got %q", got)
+	}
+	if got := to.Annotations["foreign"]; got != "keep" {
+		t.Fatalf("foreign annotation was wiped, got %q", got)
+	}
+	if *to.Spec.Replicas != 0 {
+		t.Fatalf("replicas not copied, got %d", *to.Spec.Replicas)
+	}
+}
